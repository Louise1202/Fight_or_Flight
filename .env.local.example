# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-only, NEVER exposed to the browser.
# Used by the admin dashboard to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fake email domain used to turn judge/team "usernames" into
# Supabase Auth emails behind the scenes. Any value works.
# Must match on both the login page (public) and wherever you create
# users in Supabase.
NEXT_PUBLIC_AUTH_FAKE_DOMAIN=judges.fightorflight

# Simple password gate for the organizer admin dashboard.
# This is separate from Supabase Auth - just protects /admin.
ADMIN_PASSWORD=change-me

# Optional: a long random string used to sign admin sessions. If unset,
# sessions are signed with a value derived from ADMIN_PASSWORD (changing
# the password then logs every admin out, which is fine).
ADMIN_SESSION_SECRET=

# Results emails (sent through Resend - resend.com). Leave RESEND_API_KEY
# empty and no email is ever sent (nothing else breaks).
RESEND_API_KEY=
# Optional sender, e.g. Survivor <results@betterdesk.app>. The domain must
# be verified in Resend. Empty = "<event name> <results@betterdesk.app>".
RESULTS_EMAIL_FROM=
# The public address of this app, used for links and images in emails.
PUBLIC_BASE_URL=https://race.betterdesk.app
# A long random string. Vercel Cron sends it to the every-minute job that
# closes overdue heats and sends results emails. Set it in Vercel too.
CRON_SECRET=
