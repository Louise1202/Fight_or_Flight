# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-only, NEVER exposed to the browser.
# Used by the admin dashboard to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fake email domain used to turn judge/team "usernames" into
# Supabase Auth emails behind the scenes. Any value works.
# Must match on both the login page (public) and wherever you create
# users in Supabase.
NEXT_PUBLIC_AUTH_FAKE_DOMAIN=judges.fightorflight

# Simple password gate for the organizer admin dashboard.
# This is separate from Supabase Auth - just protects /admin.
ADMIN_PASSWORD=change-me
